{
    "window.title": "PhobOS TEMPLATES",
    "workbench.sideBar.location": "left",
    "json.validate.enable": true,
    "json.schemas": [
        {
            "fileMatch": [
                "*common.json",
                "*tasks.json"
            ],
            "url": "./assets/schemas/tasks.schema.json"
        },
        {
            "fileMatch": [
                "*templates.json"
            ],
            "url": "./assets/schemas/templates.schema.json"
        }
    ],
    "tasksLabel.includeFiles": [
        "assets/tasks/common.json"
    ]
}
