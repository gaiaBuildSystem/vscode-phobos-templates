{
    "PhobOSMajor": "0",
    "Templates": [
        {
            "img": "opus.jpg",
            "folder": "genericOpus",
            "description": "Opus help you customize your PhobOS to be your OS.",
            "runtime": "opus",
            "language": "YAML",
            "multiContainer": false,
            "support": "Community",
            "status": "ok",
            "customFields": [
                {
                    "id": "osPackageName",
                    "label": "OS Package Name",
                    "placeHolder": "The OS package name, e.g. my-awesome-os",
                    "default": "",
                    "type": "text",
                    "validRegex": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                    "errorMessage": "Invalid OStree package name",
                    "description": "The name of your OS package"
                }
            ],
            "commonAssets": []
        },
        {
            "img": "cmakeconsole.jpg",
