            "args": [
                "ok"
            ],
            "dependsOrder": "sequence",
            "icon": {
                "id": "layers",
                "color": "terminal.ansiCyan"
            }
        },
        {
            "label": "run-docker-registry-wsl",
            "detail": "",
            "hide": true,
            "command": "/usr/bin/echo",
            "type": "process",
            "args": [
                "ok"
            ],
            "dependsOrder": "sequence",
            "icon": {
                "id": "layers",
                "color": "terminal.ansiCyan"
            }
        },
        {
            "label": "run-share-wsl-ports",
            "detail": "",
            "hide": true,
            "command": "xonsh",
            "type": "shell",
            "args": [
                "${workspaceFolder}/.conf/share-wsl-ports.xsh",
                "${workspaceFolder}"
            ],
            "dependsOrder": "sequence",
            "icon": {
                "id": "layers",
                "color": "terminal.ansiCyan"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated"
            }
        },
        {
            "label": "run-share-wsl-ports-debug",
            "detail": "",
            "hide": true,
            "command": "xonsh",
            "type": "shell",
            "args": [
                "${workspaceFolder}/.conf/share-wsl-ports.xsh",
                "${workspaceFolder}"
            ],
            "dependsOrder": "sequence",
            "icon": {
                "id": "layers",
                "color": "terminal.ansiCyan"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated"
            }
        },
        {
            "label": "run-torizon-binfmt",
            "detail": "",
            "hide": true,
            "command": "xonsh",
            "type": "process",
            "args": [
                "${workspaceFolder}/.conf/run-container-if-not-exists.xsh",
                "--container-runtime",
                "docker",
                "--run-arguments",
                "\"--rm --privileged torizon/binfmt:latest\"",
                "--container-name",
                "binfmt"
            ],
            "dependsOrder": "sequence",
            "icon": {
                "id": "layers",
                "color": "terminal.ansiCyan"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated"
            }
        },
        {
            "label": "check-deps",
            "detail": "This task will check if the dependencies needed to run\nthe project are installed in the host machine.",
            "command": "xonsh",
            "type": "process",
            "args": [
                "${workspaceFolder}/.conf/check-deps.xsh"
            ],
            "dependsOrder": "sequence",
            "icon": {
                "id": "layers",
                "color": "terminal.ansiCyan"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "show-project-documentation",
            "detail": "This task will open the project specific documentation\nin a new tab.",
            "command": "${command:torizon.openTemplateDocumentation}",
            "type": "process",
            "dependsOrder": "sequence",
            "problemMatcher": "$msCompile",
            "icon": {
                "id": "book",
                "color": "terminal.ansiCyan"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated"
            }
        },
        {
            "label": "reload-vscode-window",
            "detail": "Reloads this VSCode window (workspace)",
            "command": "${command:workbench.action.reloadWindow}",
            "type": "process",
            "args": [
            ],
            "dependsOrder": "sequence",
            "icon": {
                "id": "refresh",
                "color": "terminal.ansiCyan"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated"
            }
        },
        {
            "label": "apply-phobos-packages-arch",
            "detail": "This was customized to apply the Torizon dev added as a PhobOS device on the custom.yaml",
            "hide": true,
            "command": "xonsh",
            "type": "process",
            "args": [
                "${workspaceFolder}/.conf/torizon-packages.xsh",
                "${config:torizon_arch}"
            ],
            "options": {
                "env": {
                    "PHOBOS_IP": "${config:torizon_ip}",
                    "PHOBOS_PORT": "${config:torizon_debug_ssh_port}"
                }
            },
            "dependsOrder": "sequence",
            "icon": {
                "id": "gear",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "build-execution"
            }
        },
        {
            "label": "create-production-image",
            "detail": "This task will run the Opus and will create the custom image.",
            "hide": false,
            "type": "shell",
            "group": "build",
            "command": "${env:HOME}/.local/bin/opus",
            "args": [
                "--ignore-debug"
            ],
            "options": {
                "env": {
                    "DOCKER_HOST": ""
                }
            },
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$tsc"
            ],
            "icon": {
                "id": "package"
            }
        },
         {
            "label": "deploy-phobos",
            "hide": false,
            "type": "shell",
            "group": "build",
            "command": "${env:HOME}/.local/bin/opus",
            "args": [
            ],
            "options": {
                "env": {
                    "DOCKER_HOST": ""
                }
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "apply-phobos-packages-arch"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "icon": {
                "id": "package"
            }
        },
        {
            "label": "add-extension",
            "detail": "This task will add one extension to your project.\nExtensions are features, configurations or tools that need some more steps\n to be added to your project. This will add all that is needed to your project.",
            "hide": false,
            "type": "process",
            "group": "build",
            "command": "xonsh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "${workspaceFolder}/.conf/merge-extension.xsh",
                "${input:extensionsList}"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$tsc"
            ],
            "icon": {
                "id": "package"
            }
        }
    ]
}
